rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /streamers/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['nickname','createdAt']) && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 64;
      allow delete: if isOwner(uid);
      match /seasons/{seasonId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.id == seasonId && request.resource.data.name is string && request.resource.data.name.size() <= 72;
        allow delete: if isOwner(uid);
      }
    }
    match /publicSeasons/{publicId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && publicId == request.auth.uid + '_' + request.resource.data.seasonId
        && request.resource.data.keys().hasOnly(['ownerUid','seasonId','nickname','name','theme','position','phase','tickets','completed','lastEvent','currentTask','updatedAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
